SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
RAILWAY_PUBLIC_DOMAIN=
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# Optional override. Defaults to the first four production DeepInfra models, then Ollama fallback.
# DEEPINFRA_MODELS=Qwen/Qwen3-VL-235B-A22B-Instruct,Qwen/Qwen3-VL-30B-A3B-Instruct,Qwen/Qwen3.6-35B-A3B,Qwen/Qwen3.5-397B-A17B
VISION_CACHE_TTL_MS=30000
VISION_TIMEOUT_MS=20000
DEEPINFRA_TIMEOUT_MS=20000
VISION_GLOBAL_CONCURRENCY=4
VISION_QUEUE_MAX_PENDING_PER_USER=8
VISION_QUEUE_TIMEOUT_MS=30000
AUTH_CACHE_TTL_MS=60000
TRUST_PROXY=false

# Ollama is only used as the final fallback provider.
OLLAMA_URL=http://localhost:11434

# Set on the Ollama sidecar/service (not this Node app) to allow concurrent fallback inferences.
# Recommended: 2-4 depending on available VRAM/RAM. Default is 1 (serial).
# OLLAMA_NUM_PARALLEL=4
